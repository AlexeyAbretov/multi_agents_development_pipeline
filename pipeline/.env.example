# Оркестратор + deployer (docker compose из корня репозитория пайплайна).
PORT=3020
POLL_INTERVAL_MS=30000
SCHEDULE_INTERVAL_MS=3600000
# Календарь due_on milestone (IANA). T−1 / T считаются в этой зоне.
SCHEDULE_TZ=Europe/Moscow
GITHUB_TOKEN=
# Целевой продукт (issues/PR, Cursor Cloud клонирует этот репозиторий)
GITHUB_REPO=owner/your-product-repo
CURSOR_API_KEY=
CURSOR_REPO_URL=https://github.com/owner/your-product-repo
CURSOR_STARTING_REF=main
CURSOR_MODEL=composer-2.5
DATA_DIR=/data
PROMPTS_DIR=/app/prompts
# deployer: stub (по умолчанию) | compose (docker compose продукта)
DEPLOY_MODE=stub
