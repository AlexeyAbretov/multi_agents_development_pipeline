{
  "name": "pipeline-orchestrator",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run lint && npm run clean && tsc && tsc-alias",
    "test": "npm run build && node --test test/*.test.js",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "prepare": "node --input-type=commonjs -e \"try { require('simple-git-hooks/cli.js') } catch {}\"",
    "start": "node --use-env-proxy --env-file=.env.local dist/services/OrchestratorService/index.js",
    "start:deployer": "node --use-env-proxy --env-file=.env.local scripts/run-deployer.mjs dist/services/DeployerService/index.js",
    "dev": "tsx watch --env-file=.env.local src/services/OrchestratorService/index.ts",
    "dev:deployer": "tsx watch --env-file=.env.local scripts/run-deployer.mjs src/services/DeployerService/index.ts",
    "ensure-labels": "node --use-env-proxy --import tsx src/cli/ensure-labels.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.6",
    "fastify": "^5.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.18.6",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.14.0",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npm --prefix pipeline run lint"
  }
}
