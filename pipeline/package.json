{
  "name": "pipeline-orchestrator",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && tsc-alias",
    "test": "npm run build && node --test test/*.test.js",
    "start": "node --use-env-proxy --env-file=.env.local dist/index.js",
    "start:deployer": "node dist/deployer.js",
    "dev": "tsx watch src/index.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.6",
    "fastify": "^5.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
