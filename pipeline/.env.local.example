# Локальный запуск оркестратора (npm start / VSCode F5), не Docker.
# Скопируйте: copy .env.local.example .env.local
# Не коммитить .env.local.

PORT=3020
POLL_INTERVAL_MS=30000
SCHEDULE_INTERVAL_MS=3600000
SCHEDULE_TZ=Europe/Moscow
GITHUB_TOKEN=
GITHUB_REPO=owner/your-product-repo
CURSOR_API_KEY=
CURSOR_REPO_URL=https://github.com/owner/your-product-repo
CURSOR_STARTING_REF=main
CURSOR_MODEL=composer-2.5
DATA_DIR=./data
PROMPTS_DIR=./prompts
DEPLOY_MODE=stub
# Корпоративный прокси (npm start передаёт --use-env-proxy):
# HTTP_PROXY=http://127.0.0.1:3128
# HTTPS_PROXY=http://127.0.0.1:3128
