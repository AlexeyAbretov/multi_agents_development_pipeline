# Переменные для docker compose (корень репозитория пайплайна).
# Скопируйте: cp .env.example .env
# Порты сервисов: pipeline/ports.env (не дублируйте здесь).

# Путь на хосте к checkout целевого продукта (для deployer, DEPLOY_MODE=compose).
# Пример: ../llm_app_dev
PRODUCT_WORKSPACE_HOST=../your-product-repo
