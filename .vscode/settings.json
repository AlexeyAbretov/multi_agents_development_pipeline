{
  "eslint.workingDirectories": ["pipeline"],
  "eslint.useFlatConfig": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.execArgv": ["--disable-warning=DEP0190"],
  // Cursor SCM sets core.hooksPath=nul; wrapper strips it so pre-commit runs.
  "git.path": [
    "${workspaceFolder}/scripts/git-with-hooks.exe",
    "${workspaceFolder}/scripts/git-with-hooks.mjs"
  ]
}
