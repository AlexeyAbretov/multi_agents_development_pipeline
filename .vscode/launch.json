{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Orchestrator",
            "cwd": "${workspaceFolder}/pipeline",
            "runtimeArgs": [
                "--use-env-proxy",
                "--import",
                "tsx"
            ],
            "program": "${workspaceFolder}/pipeline/src/index.ts",
            "envFile": "${workspaceFolder}/pipeline/.env.local",
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}